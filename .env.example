# Copie para .env e preencha. NUNCA commite o .env.
MASTER_KEY=admin-secreto-123
POSTGRES_PASSWORD=postgres123
# Região/fila SQS REAL (o compose não tem emulador de SQS: o desafio fala em 4 bancos locais)
AWS_REGION=us-east-1
AWS_SQS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/togglemaster-queue
# Credenciais AWS (AWS Academy: copie as 3 do "AWS Details"). Usadas p/ SQS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
